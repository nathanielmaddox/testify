# @testify/website environment. Copy to .env.local for local dev.
# Never commit a real .env file; only this example is tracked.

# Canonical origin, no trailing slash. Drives metadataBase, canonicals,
# robots.txt, sitemap.xml and JSON-LD. Defaults to http://localhost:3200 while
# the site is not indexable. When NEXT_PUBLIC_SITE_INDEXABLE=true the build
# FAILS if this is unset, localhost or *.vercel.app (lib/site.config.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3200

# Launch flag. Leave unset (or false) everywhere except production after
# launch; while false, robots.txt disallows all, pages carry noindex and
# sitemap.xml is empty.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Work story previews (lib/work.ts). A story is public only when it is
# status published AND consent approved. Set true on a preview build to also
# render drafts and stories still waiting on consent (always noindex, never
# in the sitemap). `next dev` previews them anyway. The build FAILS if this
# is true together with NEXT_PUBLIC_SITE_INDEXABLE=true.
NEXT_PUBLIC_WORK_PREVIEW=false

# Analytics. Each provider stays OFF (track() no-ops for it, no script loads)
# until its id is set. Ids are public; they ship in the page.
# GA4 measurement id, G-XXXXXXXXXX.
NEXT_PUBLIC_GA4_ID=
# Google Ads tag id, AW-XXXXXXXXX, plus one conversion label per action.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
# Meta Pixel id (browser). Server-side Conversions API comes later and dedupes
# on the same event id.
NEXT_PUBLIC_META_PIXEL_ID=

# Stripe checkout (/lp/<slug>/checkout -> POST /api/checkout). Unset = the
# checkout page still renders, but /api/checkout answers 503
# checkout_not_configured and no Stripe call is made.
# Publishable key (pk_test_... / pk_live_...): public, mounts embedded Checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# SERVER ONLY, never NEXT_PUBLIC_: secret (or restricted) key, sk_test_... / rk_test_...
STRIPE_SECRET_KEY=
# SERVER ONLY: recurring Price id (price_...) of the $99/month offer, checkout
# slug done-for-you-99 (lib/checkout_server.ts stripePriceId).
STRIPE_PRICE_DONE_FOR_YOU_99=

# ---------------------------------------------------------------------------
# Integrations (lib/integrations). With nothing set, no outside call is made.
# All values below stay empty in this file. SERVER ONLY unless marked.
# Never add NEXT_PUBLIC_ to a secret.
#
# Provider choice, per concern:
#   1. An explicit switch wins. An unknown value fails at startup.
#   2. An unset switch is inferred from its key: STRIPE_SECRET_KEY -> stripe,
#      POSTMARK_SERVER_TOKEN -> postmark, RESEND_API_KEY -> resend,
#      CALCOM_API_KEY -> calcom, CONVEX_URL -> convex (data store; uploads too,
#      unless UPLOADTHING_TOKEN or S3_BUCKET is set), UPLOADTHING_TOKEN ->
#      uploadthing, S3_BUCKET -> s3.
#   3. Two candidates for one unset switch fail at startup. Set the switch.
#   4. Nothing set means `none`.
# The choice is logged once in development. See INTEGRATIONS.md.
# ---------------------------------------------------------------------------

# Provider switches: stripe | none (inferred from STRIPE_SECRET_KEY when unset)
PAYMENTS_PROVIDER=
# Provider switches: postmark | resend | none
EMAIL_PROVIDER=
# Provider switches: calcom | calendly | convex | none
BOOKING_PROVIDER=
# Provider switches: convex | none
DATA_PROVIDER=
# Provider switches: convex | uploadthing | s3 | none
UPLOAD_PROVIDER=

# Stripe webhook signing secret (whsec_...). The webhook handler is not written yet.
STRIPE_WEBHOOK_SECRET=

# Email sender, a verified address or domain in your email provider.
EMAIL_FROM=
# Owner address for lead notifications.
EMAIL_NOTIFY_TO=
# Postmark server API token (only when EMAIL_PROVIDER=postmark).
POSTMARK_SERVER_TOKEN=
# Resend API key, re_... (only when EMAIL_PROVIDER=resend).
RESEND_API_KEY=

# Cal.com API key, cal_... (only when BOOKING_PROVIDER=calcom).
CALCOM_API_KEY=
# Numeric Cal.com event type id for the discovery call.
CALCOM_EVENT_TYPE_ID=

# Convex deployment URL, https://<name>.convex.cloud (only when a Convex switch is set).
CONVEX_URL=
# Convex HTTP actions URL, https://<name>.convex.site.
CONVEX_SITE_URL=
# Convex CLI deploy key. Used by `npx convex deploy` in CI only. The app never reads it.
CONVEX_DEPLOY_KEY=

# UploadThing token (only when UPLOAD_PROVIDER=uploadthing).
UPLOADTHING_TOKEN=
# S3 region, bucket and an IAM user limited to one prefix (only when UPLOAD_PROVIDER=s3).
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
