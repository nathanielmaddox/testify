# @testify/website environment. Copy to .env.local for local dev.
# Never commit a real .env file; only this example is tracked.

# Canonical origin, no trailing slash. Drives metadataBase, canonicals,
# robots.txt, sitemap.xml and JSON-LD. Defaults to http://localhost:3200 while
# the site is not indexable. When NEXT_PUBLIC_SITE_INDEXABLE=true the build
# FAILS if this is unset, localhost or *.vercel.app (lib/site.config.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3200

# Launch flag. Leave unset (or false) everywhere except production after
# launch; while false, robots.txt disallows all, pages carry noindex and
# sitemap.xml is empty.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Analytics. Each provider stays OFF (track() no-ops for it, no script loads)
# until its id is set. Ids are public; they ship in the page.
# GA4 measurement id, G-XXXXXXXXXX.
NEXT_PUBLIC_GA4_ID=
# Google Ads tag id, AW-XXXXXXXXX, plus one conversion label per action.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
# Meta Pixel id (browser). Server-side Conversions API comes later and dedupes
# on the same event id.
NEXT_PUBLIC_META_PIXEL_ID=
