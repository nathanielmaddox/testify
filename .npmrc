# Never prompt to purge node_modules (the prompt defaults to YES and wipes every app).
# CLAUDE.md still says to pass --config.confirmModulesPurge=false; this is the belt to that brace.
confirm-modules-purge=false
auto-install-peers=true
strict-peer-dependencies=false
# The design system is a private git dependency that builds dist/ in its `prepare` script.
enable-pre-post-scripts=true
